/* rsxkit — fragment program del blit 2D: la textura con el alfa que da su
 * remapeo (1 en los formatos de la tabla de fb.c; el suyo en RSXKIT_ARGB8888
 * y en los blits hacia destinos con alfa, rsxkit_blit_alpha). */
void main(float2 texcoord : TEXCOORD0, uniform sampler2D texture : TEXUNIT0,
          out float4 color : COLOR)
{
	color = tex2D(texture, texcoord);
}
